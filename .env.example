# ─────────────────────────────────────────────────────────────
#  MagickVoice (staging) — values taken from your staging workspace
# ─────────────────────────────────────────────────────────────
MAGICKVOICE_API_BASE_URL=https://staging.appi.magickvoice.com
MAGICKVOICE_APP_URL=https://staging.app.magickvoice.com

# Paste a key from MagickVoice → Account → API keys (starts with mgkp_).
# Sent as the X-Platform-Key header (not Authorization: Bearer).
MAGICKVOICE_API_KEY=

# Sent as X-Tenant-Id / X-Account-Id on every API request
MAGICKVOICE_TENANT_ID=ac3a33b6-7975-4814-8949-0676b53caffb
MAGICKVOICE_ACCOUNT_ID=2c73f8b3-c22f-4381-b88e-c97f23aecf39

# Call script "Candidate Pre-Screening Agent"
# Variables it expects: agent_name, company_name, candidate_name, job_role, job_id, candidate_email
MAGICKVOICE_PROMPT_ID=9a046d4e-3910-4061-8eae-1e204be3d302

# Caller ID shown to the candidate (VoiceLink - Demo(2))
MAGICKVOICE_CALLER_ID=+919429391386

# ── AI quality ───────────────────────────────────────────────
# platinum = MagickVoice Platinum tier
# custom   = your own voice stack (set the three CUSTOM values below)
MAGICKVOICE_AI_PIPELINE=platinum

# Platinum (optional — blank = call script defaults)
#   Voices: Kore (default), Aoede, Charon, Fenrir, Puck, Zephyr, Orus, Callirrhoe, Autonoe, ...
#   Languages: hi, en, te, ta, kn, ml, mr, gu, bn, pa
MAGICKVOICE_PLATINUM_VOICE=
MAGICKVOICE_PLATINUM_LANGUAGE=

# Custom (used only when MAGICKVOICE_AI_PIPELINE=custom; voice stack id is required)
#   Voice stacks in this workspace:
#     94bd55c6-386d-488b-8171-04701b9809f3  Bronze (system)  voices: anushka, abhilash, manisha, vidya, arya, karun, hitesh
#                                                            languages: hi, en, te, ta, mr, kn, bn, gu, ml, pa
#     972f32a1-723d-49cc-a61f-3c855b0f67a1  Copper (system)  same voices / languages as Bronze
#     32f86f1a-2824-4b7e-833b-a1de8fad835d  Dimond           voice ids are UUIDs (e.g. f91ab3e6-5071-4e15-b016-cde6f2bcd222), language: hi
MAGICKVOICE_CUSTOM_VOICE_STACK_ID=972f32a1-723d-49cc-a61f-3c855b0f67a1
MAGICKVOICE_CUSTOM_VOICE=anushka
MAGICKVOICE_CUSTOM_LANGUAGE=en

MAGICKVOICE_ENABLE_RECORDING=true
MAGICKVOICE_MACHINE_DETECTION=false

# Automation(s) to attach to every screening call (comma-separated ids).
# Create one in MagickVoice → Automations (see README: "MagickVoice automation setup").
MAGICKVOICE_AUTOMATION_IDS=

# Also send live call-status updates (started/completed/failed) to the CRM webhook.
# Only used when PUBLIC_BASE_URL is a public https:// URL.
MAGICKVOICE_SEND_CALL_WEBHOOK=true

# Optional signing secret from the automation's Webhook step (HMAC-SHA256)
MAGICKVOICE_WEBHOOK_SECRET=

# true  = the automation's Email step runs before its Webhook step, so a webhook that
#         carries a Qualified/Disqualified result means the email went out.
MAGICKVOICE_AUTOMATION_SENDS_EMAIL=true

# ─────────────────────────────────────────────────────────────
#  CRM
# ─────────────────────────────────────────────────────────────
# Public URL where this app is reachable (needed for MagickVoice to post webhooks).
# For local testing use a tunnel, e.g. https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:3000

# Shared token appended to the webhook URL (?token=...). Keep it secret.
WEBHOOK_TOKEN=change-me-long-random-string

# Recruiter login
RECRUITER_EMAIL=recruiter@example.com
RECRUITER_PASSWORD=change-me
SESSION_SECRET=change-me-long-random-string

# Defaults used for the call-script variables
DEFAULT_COMPANY_NAME="Bilvantis Technologies"
DEFAULT_AGENT_NAME=Priya
DEFAULT_COUNTRY_CODE=+91

# Where the JSON database and uploaded resumes are stored (default: ./data)
DATA_DIR=
